# Copy this file to server/.env and fill in the values.

# MongoDB Atlas connection string. Leave empty in development to use a
# throwaway in-memory database that is seeded automatically on start.
MONGO_URI=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Port the API listens on (not 5000: macOS AirPlay Receiver uses it)
PORT=5050

# Comma-separated origins allowed to call the API from a browser
# (the React dev server runs on 5173). The Flutter app is not affected by CORS.
CLIENT_URLS=http://localhost:5173
